{
  "name": "bad-apple-console",
  "version": "1.0.2",
  "description": "Play the Bad Apple! music video inside Chrome DevTools at 30fps with zero runtime overhead.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/index.mjs",
    "dist/index.d.ts"
  ],
  "scripts": {
    "extract": "bun run scripts/extract-frames.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "bun run build.ts && bun run build:types",
    "prepublishOnly": "bun run extract && bun run build"
  },
  "keywords": [
    "bad-apple",
    "devtools",
    "console",
    "ascii-art",
    "video",
    "chrome",
    "easter-egg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alienpingu/bad-apple-console.git"
  },
  "author": "alienpingu",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
